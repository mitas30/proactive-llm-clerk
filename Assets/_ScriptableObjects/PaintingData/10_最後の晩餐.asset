  m_Name: "10_\u6700\u5F8C\u306E\u6669\u9910"
  m_EditorClassIdentifier: 
  paintingID: 10
  paintingName: "\u6700\u5F8C\u306E\u6669\u9910"
  artistName: "\u30EC\u30AA\u30CA\u30EB\u30C9\u30FB\u30C0\u30FB\u30F4\u30A3\u30F3\u30C1"
  infoText: "\u300C\u3042\u306A\u305F\u305F\u3061\u306E\u4E00\u4EBA\u304C\u79C1\u3092\u88CF\u5207\u308B\u300D\u3068\u3044\u3046\u30AD\u30EA\u30B9\u30C8\u306E\u8A00\u8449\u304C\u653E\u305F\u308C\u305F\u3001\u305D\u306E\u77AC\u9593\u306E\u5F1F\u5B50\u305F\u3061\u306E\u52D5\u63FA\u304C\u63CF\u304B\u308C\u3066\u3044\u307E\u3059\u3002\n\u5B8C\u74A7\u306A\u4E00\u70B9\u900F\u8996\u56F3\u6CD5\u3067\u63CF\u304B\u308C\u305F\u9759\u304B\u306A\u98DF\u5353\u3068\u306F\u88CF\u8179\u306B\u30013\u4EBA\u305A\u3064\u306E\u30B0\u30EB\u30FC\u30D7\u306B\u5206\u3051\u3089\u308C\u305F\u5F1F\u5B50\u305F\u3061\u306E\u9593\u3067\u306F\u6FC0\u3057\u3044\u30C9\u30E9\u30DE\u304C\u6E26\u5DFB\u3044\u3066\u3044\u307E\u3059\u3002\n\u30AD\u30EA\u30B9\u30C8\u306E\u53F3\u96A3\u3067\u3001\u9280\u8CA8\u306E\u888B\u3092\u63E1\u308A\u3057\u3081\u3066\u3044\u308B\u306E\u306F\u8AB0\u306A\u306E\u3067\u3057\u3087\u3046\u304B\u3002"
  yearOfProduction: 1495
  endYearOfProduction: 1498
  width: 880
  height: 460
  exhibitionAreaName: B
  additionalInfomation: "\u30DF\u30E9\u30CE\u306E\u4FEE\u9053\u9662\u306B\u3042\u308B\u58C1\u753B\u3067\u3001\u4F1D\u7D71\u7684\u306A\u30D5\u30EC\u30B9\u30B3\u3067\u306F\u306A\u304F\u6CB9\u6C17\u306E\u3042\u308B\u30C6\u30F3\u30DA\u30E9\u3068\u3044\u3046\u5B9F\u9A13\u7684\u6280\u6CD5\u3092\u7528\u3044\u305F\u305F\u3081\u3001\u5B8C\u6210\u76F4\u5F8C\u304B\u3089\u5265\u843D\u304C\u9032\u307F\u3001\u73FE\u5728\u306F\u53B3\u91CD\u306A\u7BA1\u7406\u4E0B\u306B\u3042\u308B\n\n1999\u5E74\u306B\u5B8C\u4E86\u3057\u305F\u5927\u4FEE\u5FA9\u306B\u3088\u308A\u3001\u5F8C\u4E16\u306E\u52A0\u7B46\u304C\u53D6\u308A\u9664\u304B\u308C\u30EC\u30AA\u30CA\u30EB\u30C9\u306E\u30AA\u30EA\u30B8\u30CA\u30EB\u306E\u7B46\u81F4\u304C\u56DE\u5FA9\u3055\u308C\u305F\u3068\u3044\u3046\u7D4C\u7DEF\u304C\u3042\u308A\u3001\u305D\u306E\u4FEE\u5FA9\u53F2\u81EA\u4F53\u3082\u4F5C\u54C1\u306E\u8A9E\u308A\u8349\u3068\u306A\u3063\u3066\u3044\u308B\n\n\u753B\u9762\u4E2D\u592E\u306E\u30AD\u30EA\u30B9\u30C8\u306B\u6D88\u5931\u70B9\u304C\u96C6\u307E\u308B\u4E00\u70B9\u900F\u8996\u56F3\u6CD5\u304C\u7528\u3044\u3089\u308C\u3066\u3044\u308B\u305F\u3081\u3001\u30C0\u30A4\u30CB\u30F3\u30B0\u30C6\u30FC\u30D6\u30EB\u306E\u4E2D\u592E\u306B\u5408\u308F\u305B\u3066\u98FE\u308B\u3053\u3068\u3067\u3001\u9451\u8CDE\u8005\u306E\u8996\u7DDA\u304C\u81EA\u7136\u3068\u6574\u3044\u3001\u7A7A\u9593\u306B\u5965\u884C\u304D\u304C\u751F\u307E\u308C\u308B"
