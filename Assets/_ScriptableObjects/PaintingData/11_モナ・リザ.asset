  paintingID: 11
  paintingName: "\u30E2\u30CA\u30FB\u30EA\u30B6"
  artistName: "\u30EC\u30AA\u30CA\u30EB\u30C9\u30FB\u30C0\u30FB\u30F4\u30A3\u30F3\u30C1"
  infoText: "\u4E16\u754C\u3067\u6700\u3082\u6709\u540D\u306A\u3053\u306E\u8096\u50CF\u753B\u306F\u3001\u591A\u304F\u306E\u8B0E\u306B\u5305\u307E\u308C\u3066\u3044\u307E\u3059\u3002\n\u30E2\u30C7\u30EB\u306F\u30D5\u30A3\u30EC\u30F3\u30C4\u30A7\u306E\u5546\u4EBA\u30D5\u30E9\u30F3\u30C1\u30A7\u30B9\u30B3\u30FB\u30C7\u30EB\u30FB\u30B8\u30E7\u30B3\u30F3\u30C9\u306E\u59BB\u30EA\u30B6\u3068\u3055\u308C\u3066\u3044\u307E\u3059\u304C\u3001\u78BA\u8A3C\u306F\u3042\u308A\u307E\u305B\u3093\u3002\n\u3088\u304F\u898B\u308B\u3068\u5F7C\u5973\u306B\u306F\u7709\u6BDB\u304C\u3042\u308A\u307E\u305B\u3093\u304C\u3001\u3053\u308C\u306F\u5F53\u6642\u306E\u6D41\u884C\u3060\u3063\u305F\u306E\u3067\u3057\u3087\u3046\u304B\u3001\u305D\u308C\u3068\u3082\u672A\u5B8C\u6210\u306A\u306E\u3067\u3057\u3087\u3046\u304B\u3002\u5F7C\u5973\u306E\u8B0E\u3081\u3044\u305F\u5FAE\u7B11\u307F\u306F\u3001\u4E00\u4F53\u4F55\u3092\u8A9E\u3063\u3066\u3044\u308B\u306E\u3067\u3057\u3087\u3046\u3002"
  yearOfProduction: 1503
  endYearOfProduction: 1519
  width: 53
  height: 77
  exhibitionAreaName: F
  additionalInfomation: "\u30EB\u30FC\u30F4\u30EB\u7F8E\u8853\u9928\u306E\u81F3\u5B9D\u3067\u3042\u308A\u3001\u30E2\u30C7\u30EB\u306F\u30EA\u30B6\u30FB\u30B2\u30E9\u30EB\u30C7\u30A3\u30FC\u30CB\u3068\u3055\u308C\u308B\u304C\u3001\u30EC\u30AA\u30CA\u30EB\u30C9\u304C\u4F9D\u983C\u4E3B\u306B\u6E21\u3055\u305A\u6B7B\u306C\u307E\u3067\u624B\u5143\u306B\u7F6E\u3044\u3066\u7B46\u3092\u5165\u308C\u7D9A\u3051\u305F\u3001\u753B\u5BB6\u306E\u9B42\u304C\u8FBC\u3081\u3089\u308C\u305F\u4F5C\u54C1\n\n2005\u5E74\u306E\u66F8\u304D\u8FBC\u307F\u767A\u898B\u306B\u3088\u308B\u5236\u4F5C\u5E74\u306E\u88CF\u4ED8\u3051\u3084\u30011911\u5E74\u306E\u76D7\u96E3\u4E8B\u4EF6\u306A\u3069\u3001\u7D75\u753B\u305D\u306E\u3082\u306E\u306E\u7F8E\u3057\u3055\u4EE5\u5916\u306B\u3082\u300C\u540D\u753B\u306B\u306A\u308B\u305F\u3081\u306E\u7269\u8A9E\u300D\u3092\u6570\u591A\u304F\u6301\u3061\u3001\u8A71\u984C\u6027\u306B\u4E8B\u6B20\u304B\u306A\u3044\n\n\u30DD\u30D7\u30E9\u6750\u306B\u63CF\u304B\u308C\u305F\u6CB9\u5F69\u753B\u3067\u3042\u308A\u3001\u305D\u306E\u30B9\u30D5\u30DE\u30FC\u30C8\uFF08\u307C\u304B\u3057\u6280\u6CD5\uFF09\u306B\u3088\u308B\u795E\u79D8\u7684\u306A\u8868\u60C5\u306F\u3001\u9670\u8B00\u8AD6\u7684\u306A\u8A71\u984C\u3092\u6392\u3057\u3066\u3082\u306A\u304A\u3001\u898B\u308B\u8005\u3092\u60F9\u304D\u3064\u3051\u308B\u5727\u5012\u7684\u306A\u9B45\u529B\u3092\u6301\u3063\u3066\u3044\u308B"
