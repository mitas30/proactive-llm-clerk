  paintingID: 12
  paintingName: "\u30C0\u30CA\u30A8"
  artistName: "\u30EC\u30F3\u30D6\u30E9\u30F3\u30C8"
  infoText: "\u9EC4\u91D1\u306E\u96E8\u306B\u59FF\u3092\u5909\u3048\u305F\u795E\u30BC\u30A6\u30B9\u3092\u5F85\u3061\u53D7\u3051\u308B\u738B\u5973\u30C0\u30CA\u30A8\u3002\nX\u7DDA\u8ABF\u67FB\u306B\u3088\u308A\u3001\u3053\u306E\u7D75\u304C\u5F8C\u306B\u30EC\u30F3\u30D6\u30E9\u30F3\u30C8\u81EA\u8EAB\u306E\u624B\u3067\u5927\u5E45\u306B\u63CF\u304D\u76F4\u3055\u308C\u305F\u3053\u3068\u304C\u5224\u660E\u3057\u3066\u3044\u307E\u3059\u3002\n\u5F53\u521D\u30C0\u30CA\u30A8\u306E\u30E2\u30C7\u30EB\u306F\u5F7C\u306E\u59BB\u30B5\u30B9\u30AD\u30A2\u3067\u3057\u305F\u304C\u3001\u63CF\u304D\u76F4\u3057\u5F8C\u306E\u9854\u306F\u3001\u5F7C\u306E\u611B\u4EBA\u30D8\u30FC\u30EB\u30C1\u30A7\u306B\u4F3C\u3066\u3044\u308B\u306E\u3067\u3059\u3002\u306A\u305C\u5F7C\u306F\u3001\u4E00\u5EA6\u5B8C\u6210\u3057\u305F\u306F\u305A\u306E\u59BB\u306E\u9854\u3092\u3001\u611B\u4EBA\u306E\u9854\u306B\u5909\u3048\u305F\u306E\u3067\u3057\u3087\u3046\u304B\u3002"
  yearOfProduction: 1636
  endYearOfProduction: 1643
  width: 202.5
  height: 203
  exhibitionAreaName: A
  additionalInfomation: "\u30A8\u30EB\u30DF\u30BF\u30FC\u30B8\u30E5\u7F8E\u8853\u9928\u306E\u540D\u7269\u3067\u3042\u308A\u30011985\u5E74\u306E\u8972\u6483\u4E8B\u4EF6\u3067\u5927\u304D\u306A\u640D\u50B7\u3092\u53D7\u3051\u305F\u304C\u300112\u5E74\u306E\u4FEE\u5FA9\u3092\u7D4C\u3066\u300C\u50B7\u3092\u62B1\u3048\u305F\u307E\u307E\u4FDD\u5B58\u30FB\u9451\u8CDE\u3055\u308C\u308B\u300D\u73FE\u4EE3\u306E\u7F8E\u8853\u9928\u5B66\u306E\u8C61\u5FB4\u3068\u306A\u3063\u305F\n\n\u9EC4\u91D1\u306E\u96E8\u306B\u5909\u8EAB\u3057\u305F\u30BC\u30A6\u30B9\u3092\u8FCE\u3048\u308B\u795E\u8A71\u306E\u5834\u9762\u3067\u3042\u308A\u3001\u30EC\u30F3\u30D6\u30E9\u30F3\u30C8\u7279\u6709\u306E\u67D4\u3089\u304B\u3044\u5149\u304C\u808C\u306E\u8CEA\u611F\u3092\u7167\u660E\u306E\u3088\u3046\u306B\u6D6E\u304B\u3073\u4E0A\u304C\u3089\u305B\u308B\u305F\u3081\u3001\u5BDD\u5BA4\u306A\u3069\u306E\u30D7\u30E9\u30A4\u30D9\u30FC\u30C8\u306A\u7A7A\u9593\u306B\u9069\u3059\u308B\n\n\u5370\u5237\u7269\u3068\u3057\u3066\u9078\u3076\u969B\u306F\u3001\u5149\u6CA2\u3092\u6291\u3048\u305F\u30DE\u30C3\u30C8\u5BC4\u308A\u306E\u7D19\u8CEA\u3092\u9078\u3076\u3053\u3068\u3067\u3001\u767D\u98DB\u3073\u3092\u9632\u304E\u3001\u30EC\u30F3\u30D6\u30E9\u30F3\u30C8\u3089\u3057\u3044\u300C\u6C88\u3093\u3060\u91D1\u300D\u306E\u91CD\u539A\u306A\u8F1D\u304D\u3092\u518D\u73FE\u3057\u3084\u3059\u304F\u306A\u308B"
