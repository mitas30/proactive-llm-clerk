  m_Script: {fileID: 11500000, guid: d71622aa54db2aa43af6d912093692fa, type: 3}
  m_Name: "13_\u653E\u8569\u606F\u5B50\u306E\u5E30\u9084"
  m_EditorClassIdentifier: 
  paintingID: 13
  paintingName: "\u653E\u8569\u606F\u5B50\u306E\u5E30\u9084"
  artistName: "\u30EC\u30F3\u30D6\u30E9\u30F3\u30C8"
  infoText: "\u8CA1\u7523\u3092\u4F7F\u3044\u679C\u305F\u3057\u3001\u7121\u4E00\u6587\u3067\u5E30\u3063\u3066\u304D\u305F\u606F\u5B50\u3092\u3001\u7236\u304C\u9759\u304B\u306B\u62B1\u304D\u3057\u3081\u308B\u611F\u52D5\u306E\u5834\u9762\u3002\n\u3057\u304B\u3057\u3001\u606F\u5B50\u306E\u80CC\u306B\u7F6E\u304B\u308C\u305F\u7236\u306E\u4E21\u624B\u306F\u3001\u3088\u304F\u898B\u308B\u3068\u5DE6\u53F3\u3067\u9055\u3044\u307E\u3059\u3002\u5DE6\u624B\u306F\u529B\u5F37\u3044\u7537\u6027\u306E\u624B\u3001\u53F3\u624B\u306F\u512A\u7F8E\u306A\u5973\u6027\u306E\u624B\u306E\u3088\u3046\u306B\u63CF\u304B\u308C\u3066\u3044\u307E\u3059\u3002\u3053\u308C\u306F\u7236\u6027\u3068\u6BCD\u6027\u306E\u4E21\u65B9\u3092\u517C\u306D\u5099\u3048\u305F\u3001\u795E\u306E\u7121\u511F\u306E\u611B\u3092\u8C61\u5FB4\u3057\u3066\u3044\u308B\u306E\u3067\u3057\u3087\u3046\u304B\u3002\n\u30EC\u30F3\u30D6\u30E9\u30F3\u30C8\u6700\u6669\u5E74\u306E\u5091\u4F5C\u3067\u3059\u3002"
  yearOfProduction: 1668
  endYearOfProduction: 0
  width: 205
  height: 262
  exhibitionAreaName: B
  additionalInfomation: "\u30EC\u30F3\u30D6\u30E9\u30F3\u30C8\u6700\u6669\u5E74\u306E\u5230\u9054\u70B9\u3068\u3055\u308C\u308B\u30A8\u30EB\u30DF\u30BF\u30FC\u30B8\u30E5\u7F8E\u8853\u9928\u6240\u8535\u306E\u5927\u4F5C\u3067\u3001\u5287\u7684\u306A\u77AC\u9593\u3067\u306F\u306A\u304F\u3001\u9759\u304B\u306A\u8D66\u3057\u306E\u300C\u6301\u7D9A\u3059\u308B\u6642\u9593\u300D\u3092\u63CF\u3044\u305F\u3001\u7CBE\u795E\u6027\u306E\u9AD8\u3044\u5B97\u6559\u753B\u306E\u5091\u4F5C\n\n\u30D0\u30C1\u30AB\u30F3\u306E\u300C\u6148\u60B2\u306E\u8056\u5E74\u300D\u306E\u8C61\u5FB4\u306B\u3082\u9078\u3070\u308C\u305F\u4F5C\u54C1\u3067\u3001\u4EBA\u9593\u304C\u7B49\u8EAB\u5927\u3067\u305D\u3053\u306B\u3044\u308B\u3088\u3046\u306A\u81E8\u5834\u611F\u304C\u3042\u308A\u3001\u898B\u308B\u8005\u306E\u611F\u60C5\u3092\u63FA\u3055\u3076\u308B\u529B\u3092\u6301\u3063\u3066\u3044\u308B\n\n\u5BB6\u65CF\u304C\u96C6\u307E\u308B\u30EA\u30D3\u30F3\u30B0\u3060\u3051\u3067\u306A\u304F\u3001\u4ED5\u4E8B\u90E8\u5C4B\u306A\u3069\u306B\u98FE\u308B\u3053\u3068\u3067\u300C\u8CAC\u3081\u308B\u306E\u3067\u306F\u306A\u304F\u53D7\u3051\u6B62\u3081\u308B\u300D\u3068\u3044\u3046\u5305\u5BB9\u529B\u306E\u3042\u308B\u7A7A\u6C17\u3092\u7A7A\u9593\u306B\u3082\u305F\u3089\u3057\u3001\u65E5\u3005\u306E\u751F\u6D3B\u306B\u5B89\u3089\u304E\u3092\u4E0E\u3048\u308B"
