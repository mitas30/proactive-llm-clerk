  m_Name: "14_\u30AF\u30E9\u30A6\u30C7\u30A3\u30A6\u30B9\u30FB\u30AD\u30A6\u30A3\u30EA\u30B9\u306E\u9670\u8B00"
  m_EditorClassIdentifier: 
  paintingID: 14
  paintingName: "\u30AF\u30E9\u30A6\u30C7\u30A3\u30A6\u30B9\u30FB\u30AD\u30A6\u30A3\u30EA\u30B9\u306E\u9670\u8B00"
  artistName: "\u30EC\u30F3\u30D6\u30E9\u30F3\u30C8"
  infoText: "\u53E4\u4EE3\u30ED\u30FC\u30DE\u3078\u306E\u53CD\u4E71\u3092\u8A93\u3046\u30D0\u30BF\u30F4\u30A3\u30A2\u4EBA\u306E\u82F1\u96C4\u305F\u3061\u3002\n\u5B9F\u306F\u3053\u306E\u4F5C\u54C1\u306F\u3001\u304B\u3064\u3066\u3053\u306E5\u500D\u3082\u306E\u5927\u304D\u3055\u304C\u3042\u3063\u305F\u5DE8\u5927\u306A\u58C1\u753B\u3067\u3057\u305F\u3002\u3057\u304B\u3057\u3001\u4F9D\u983C\u4E3B\u3067\u3042\u3063\u305F\u30A2\u30E0\u30B9\u30C6\u30EB\u30C0\u30E0\u5E02\u5E81\u820E\u306F\u306A\u305C\u304B\u3053\u306E\u5091\u4F5C\u306E\u53D7\u3051\u53D6\u308A\u3092\u62D2\u5426\u3002\n\u30EC\u30F3\u30D6\u30E9\u30F3\u30C8\u306F\u751F\u6D3B\u306E\u305F\u3081\u306B\u3001\u7D75\u306E\u4E2D\u5FC3\u90E8\u5206\u3060\u3051\u3092\u5207\u308A\u53D6\u3063\u3066\u58F2\u5374\u305B\u3056\u308B\u3092\u5F97\u307E\u305B\u3093\u3067\u3057\u305F\u3002"
  yearOfProduction: 1661
  endYearOfProduction: 1662
  width: 309
  height: 196
  exhibitionAreaName: D
  additionalInfomation: "\u5143\u306F\u30A2\u30E0\u30B9\u30C6\u30EB\u30C0\u30E0\u5E02\u5E81\u820E\u306E\u305F\u3081\u306B\u63CF\u304B\u308C\u305F\u5DE8\u5927\u306A\u6B74\u53F2\u753B\u3060\u3063\u305F\u304C\u3001\u53D7\u3051\u53D6\u308A\u3092\u62D2\u5426\u3055\u308C\u3001\u753B\u5BB6\u81EA\u8EAB\u306E\u624B\u306B\u3088\u3063\u3066\u5927\u5E45\u306B\u5207\u308A\u8A70\u3081\u3089\u308C\u305F\u3068\u3044\u3046\u3001\u632B\u6298\u3068\u57F7\u5FF5\u304C\u523B\u307E\u308C\u305F\u4F5C\u54C1\n\n\u73FE\u5728\u306F\u30B9\u30C8\u30C3\u30AF\u30DB\u30EB\u30E0\u306B\u3042\u308A\u3001\u539A\u5857\u308A\u306E\u7D75\u5177\u3068\u300C\u5100\u5F0F\u306E\u708E\u300D\u306E\u3088\u3046\u306A\u5F37\u3044\u5149\u3001\u8352\u3005\u3057\u3044\u30BF\u30C3\u30C1\u304C\u7279\u5FB4\u3067\u3001\u6697\u3044\u90E8\u5C4B\u3067\u3082\u5F37\u70C8\u306A\u30A4\u30F3\u30D1\u30AF\u30C8\u3092\u653E\u3064\u4E3B\u5F79\u7D1A\u306E\u4E00\u679A\u3068\u306A\u308B\n\n\u5168\u4F53\u56F3\u3060\u3051\u3067\u306A\u304F\u3001\u8A93\u3044\u3092\u7ACB\u3066\u308B\u5263\u3084\u5149\u306E\u4E2D\u5FC3\u90E8\u5206\u3092\u30AF\u30ED\u30FC\u30BA\u30A2\u30C3\u30D7\u3057\u305F\u5546\u54C1\u3068\u3057\u3066\u3082\u4EBA\u6C17\u304C\u3042\u308A\u3001\u56FD\u5BB6\u3078\u306E\u5FE0\u8AA0\u3084\u88CF\u5207\u308A\u3068\u3044\u3063\u305F\u91CD\u539A\u306A\u30C6\u30FC\u30DE\u304C\u77E5\u7684\u306A\u95A2\u5FC3\u3092\u547C\u3076"
