  paintingName: "\u591C\u8B66"
  artistName: "\u30EC\u30F3\u30D6\u30E9\u30F3\u30C8"
  infoText: "\u5F53\u6642\u306E\u96C6\u56E3\u8096\u50CF\u753B\u306F\u3001\u5168\u54E1\u304C\u540C\u3058\u3088\u3046\u306B\u63CF\u304B\u308C\u308B\u306E\u304C\u5E38\u8B58\u3067\u3057\u305F\u3002\n\u3057\u304B\u3057\u30EC\u30F3\u30D6\u30E9\u30F3\u30C8\u306F\u3001\u307E\u308B\u3067\u6F14\u5287\u306E\u4E00\u5834\u9762\u306E\u3088\u3046\u306B\u3001\u52D5\u304D\u3068\u5149\u306B\u6E80\u3061\u305F\u5287\u7684\u306A\u4F5C\u54C1\u3068\u3057\u3066\u63CF\u304D\u4E0A\u3052\u307E\u3057\u305F\u3002\u305D\u306E\u305F\u3081\u3001\u652F\u6255\u3063\u305F\u91D1\u984D\u306E\u5272\u306B\u5C0F\u3055\u304F\u63CF\u304B\u308C\u305F\u308A\u3001\u5F71\u306B\u96A0\u308C\u3066\u3057\u307E\u3063\u305F\u968A\u54E1\u304B\u3089\u4E0D\u6E80\u304C\u51FA\u305F\u3068\u3082\u8A00\u308F\u308C\u3066\u3044\u307E\u3059\u3002\n\u3053\u306E\u7D75\u306E\u4E2D\u592E\u3067\u8F1D\u304F\u5C11\u5973\u306F\u3001\u4E00\u4F53\u4F55\u8005\u306A\u306E\u3067\u3057\u3087\u3046\u304B\u3002"
  yearOfProduction: 1642
  endYearOfProduction: 0
  width: 453.5
  height: 379.5
  exhibitionAreaName: E
  additionalInfomation: "\u30A2\u30E0\u30B9\u30C6\u30EB\u30C0\u30E0\u56FD\u7ACB\u7F8E\u8853\u9928\uFF08\u30EA\u30A4\u30AF\u30B9\u30DF\u30E5\u30FC\u30B8\u30A2\u30E0\uFF09\u306E\u9854\u3067\u3042\u308A\u3001\u9759\u6B62\u3057\u305F\u8A18\u5FF5\u64AE\u5F71\u306E\u3088\u3046\u306A\u96C6\u56E3\u8096\u50CF\u753B\u3092\u3001\u52D5\u304D\u306E\u3042\u308B\u300C\u7FA4\u50CF\u5287\u300D\u3078\u3068\u5909\u9769\u3057\u305F\u8A18\u5FF5\u7891\u7684\u306A\u4F5C\u54C1\n\n\u304B\u3064\u3066\u306E\u79FB\u8A2D\u6642\u306B\u56DB\u8FBA\u304C\u5207\u308A\u843D\u3068\u3055\u308C\u305F\u6B74\u53F2\u3084\u3001\u8FD1\u5E74\u306E\u300C\u30AA\u30DA\u30EC\u30FC\u30B7\u30E7\u30F3\u30FB\u30CA\u30A4\u30C8\u30A6\u30A9\u30C3\u30C1\u300D\u306B\u3088\u308B\u516C\u958B\u4FEE\u5FA9\u306A\u3069\u3001\u5B8C\u6210\u5F8C\u3082\u5909\u5316\u3057\u7D9A\u3051\u3001\u7814\u7A76\u5BFE\u8C61\u3068\u306A\u308A\u7D9A\u3051\u308B\u751F\u304D\u305F\u540D\u753B\u3067\u3042\u308B\n\n2025\u5E74\u306B\u306F\u63CF\u304B\u308C\u305F\u72AC\u306B\u95A2\u3059\u308B\u65B0\u767A\u898B\u304C\u5831\u3058\u3089\u308C\u308B\u306A\u3069\u3001\u5E38\u306B\u65B0\u3057\u3044\u8A71\u984C\u3092\u63D0\u4F9B\u3057\u7D9A\u3051\u308B\u4F5C\u54C1\u3067\u3042\u308A\u3001\u305D\u306E\u7269\u8A9E\u6027\u3068\u753B\u9762\u306E\u30C9\u30E9\u30DE\u30C1\u30C3\u30AF\u306A\u660E\u6697\u306F\u3001\u9451\u8CDE\u8005\u3092\u98FD\u304D\u3055\u305B\u306A\u3044"
