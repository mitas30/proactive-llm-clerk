  paintingID: 1
  paintingName: Medea about to Kill Her Children
  artistName: "\u30A6\u30B8\u30A7\u30FC\u30CC\u30FB\u30C9\u30E9\u30AF\u30ED\u30EF"
  infoText: "\u5FA9\u8B90\u306E\u305F\u3081\u306B\u6211\u304C\u5B50\u3092\u624B\u306B\u304B\u3051\u3088\u3046\u3068\u3059\u308B\u738B\u5973\u30E1\u30C7\u30A3\u30A2\u3002\n\u6D1E\u7A9F\u306B\u5DEE\u3057\u8FBC\u3080\u5149\u306F\u5F7C\u5973\u306E\u7F8E\u3057\u3044\u8089\u4F53\u3092\u7167\u3089\u3057\u307E\u3059\u304C\u3001\u305D\u306E\u9854\u306E\u534A\u5206\u306F\u6DF1\u3044\u5F71\u306B\u8986\u308F\u308C\u3066\u3044\u307E\u3059\u3002\u3053\u306E\u5149\u3068\u5F71\u306E\u5BFE\u6BD4\u306F\u3001\u6BCD\u3068\u3057\u3066\u306E\u611B\u3068\u88CF\u5207\u3089\u308C\u305F\u618E\u3057\u307F\u3068\u3044\u3046\u3001\u5F7C\u5973\u306E\u5185\u9762\u306E\u6FC0\u3057\u3044\u845B\u85E4\u3092\u6620\u3057\u51FA\u3057\u3066\u3044\u308B\u304B\u306E\u3088\u3046\u3067\u3059\u3002\n\u5F7C\u5973\u306E\u77B3\u306E\u5965\u306B\u3001\u3042\u306A\u305F\u306F\u3069\u3093\u306A\u611F\u60C5\u3092\u8AAD\u307F\u53D6\u308A\u307E\u3059\u304B\uFF1F"
  yearOfProduction: 1862
  endYearOfProduction: 0
  width: 84.5
  height: 122.5
  exhibitionAreaName: A
  additionalInfomation: "\u3053\u306E\u4F5C\u54C1\u306F\u30EB\u30FC\u30F4\u30EB\u7F8E\u8853\u9928\u306E\u6240\u8535\u3067\u3001\u7F72\u540D\u3068\u5E74\u8A18\u304C\u5DE6\u4E0B\u306B\u5165\u308A\u3001\u7D20\u6750\u306F\u6CB9\u5F69\u30FB\u30AB\u30F3\u30F4\u30A1\u30B9\u3001\u30B5\u30A4\u30BA\u306F\u7E26\u7D04122.5cm\xD7\u6A2A\u7D0484.5cm\u3068\u3001\u5C55\u793A\u6620\u3048\u3059\u308B\u300C\u4EBA\u7269\u753B\u3068\u3057\u3066\u306F\u3057\u3063\u304B\u308A\u5927\u304D\u3044\u300D\u30B9\u30B1\u30FC\u30EB\u611F\r\n\u3058\u3064\u306F\u30C9\u30E9\u30AF\u30ED\u30EF\u304C1838\u5E74\u306B\u30B5\u30ED\u30F3\u306B\u51FA\u3057\u305F\u5927\u4F5C\u300A\u72C2\u3048\u308B\u30E1\u30C7\u30A3\u30A2\u300B\uFF08\u73FE\u5728\u306F\u30EA\u30FC\u30EB\u306E\u30D1\u30EC\u30FB\u30C7\u30FB\u30DC\u30B6\u30FC\u30EB\u7F8E\u8853\u9928\uFF09\u3092\u3001\u306E\u3061\u306B\u7E2E\u5C0F\u3057\u3064\u3064\u5DEE\u7570\u3082\u52A0\u3048\u3066\u201C\u5225\u30F4\u30A1\u30FC\u30B8\u30E7\u30F3\u201D\u3068\u3057\u3066\u4ED5\u4E0A\u3052\u305F\u4F4D\u7F6E\u3065\u3051\u3067\u3001\u540C\u3058\u4E3B\u984C\u3067\u3082\u5E74\u4EE3\u3067\u89E3\u91C8\u304C\u5909\u308F\u308B\r\n\u30D5\u30E9\u30F3\u30B9\u6587\u5316\u7701\u306E\u4F5C\u54C1\u30C7\u30FC\u30BF\u30D9\u30FC\u30B9\u3067\u306F\u30011862\u5E74\u306B\u9280\u884C\u5BB6\u30A8\u30DF\u30FC\u30EB\u30FB\u30DA\u30EC\u30FC\u30EB\u306E\u58F2\u7ACB\u306B\u95A2\u308F\u308B\u8A18\u9332\u306A\u3069\u3001\u8907\u6570\u306E\u6240\u6709\u8005\u3092\u7D4C\u305F\u60C5\u5831\u304C\u307E\u3068\u307E\u3063\u3066\u304A\u308A\u3001\u201C\u5F53\u6642\u306E\u5BCC\u88D5\u5C64\u304C\u6B32\u3057\u304C\u3063\u305F\u30C9\u30E9\u30AF\u30ED\u30EF\u6669\u5E74\u306E\u4E3B\u984C\u201D\u3067\u3042\u308B\r\n\u6697\u3044\u80CC\u666F\u306B\u8089\u4F53\u306E\u30CF\u30A4\u30E9\u30A4\u30C8\u304C\u7ACB\u3064\u306E\u3067\u3001\u30DE\u30C3\u30C8\u7CFB\u306E\u7D19\u3084\u843D\u3061\u7740\u3044\u305F\u984D\u88C5\u3067\u30B3\u30F3\u30C8\u30E9\u30B9\u30C8\u3092\u4FDD\u3064\u3068\u3001\u30EB\u30FC\u30F4\u30EB\u4F5C\u54C1\u3089\u3057\u3044\u201C\u6DF1\u3044\u9ED2\u201D\u304C\u51FA\u3084\u3059\u3044\u3002"
