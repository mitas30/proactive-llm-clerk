  m_Name: "2_\u6C11\u8846\u3092\u5C0E\u304F\u81EA\u7531\u306E\u5973\u795E"
  m_EditorClassIdentifier: 
  paintingID: 2
  paintingName: "\u6C11\u8846\u3092\u5C0E\u304F\u81EA\u7531\u306E\u5973\u795E"
  artistName: "\u30A6\u30B8\u30A7\u30FC\u30CC\u30FB\u30C9\u30E9\u30AF\u30ED\u30EF"
  infoText: "\u30D5\u30E9\u30F3\u30B97\u6708\u9769\u547D\u3092\u63CF\u3044\u305F\u3053\u306E\u7D75\u306E\u4E2D\u5FC3\u306B\u7ACB\u3064\u306E\u306F\u3001\u5B9F\u5728\u306E\u4EBA\u7269\u3067\u306F\u3042\u308A\u307E\u305B\u3093\u3002\u5F7C\u5973\u306F\u300C\u81EA\u7531\u300D\u3092\u8C61\u5FB4\u3059\u308B\u5973\u795E\u3067\u3042\u308A\u3001\u5A3C\u5A66\u3092\u30E2\u30C7\u30EB\u306B\u3057\u305F\u3068\u3082\u8A00\u308F\u308C\u3066\u3044\u307E\u3059\u3002\n\u306A\u305C\u30C9\u30E9\u30AF\u30ED\u30EF\u306F\u3001\u795E\u8056\u306A\u7406\u5FF5\u306E\u8C61\u5FB4\u3068\u3057\u3066\u3001\u793E\u4F1A\u306E\u5E95\u8FBA\u306B\u751F\u304D\u305F\u5973\u6027\u306E\u59FF\u3092\u9078\u3093\u3060\u306E\u3067\u3057\u3087\u3046\u304B\u3002\u305D\u306E\u305F\u304F\u307E\u3057\u3044\u59FF\u306F\u3001\u9769\u547D\u306E\u771F\u306E\u62C5\u3044\u624B\u304C\u8AB0\u3067\u3042\u3063\u305F\u304B\u3092\u7269\u8A9E\u3063\u3066\u3044\u307E\u3059\u3002"
  yearOfProduction: 1830
  endYearOfProduction: 0
  width: 325
  height: 260
  exhibitionAreaName: D
  additionalInfomation: "\u30EB\u30FC\u30F4\u30EB\u7F8E\u8853\u9928\u306E\u770B\u677F\u4F5C\u54C1\u3067\u3001\u6CB9\u5F69\u30FB\u30AB\u30F3\u30F4\u30A1\u30B9\u3001\u7E26\u7D04260cm\xD7\u6A2A\u7D04325cm\u3068\u3044\u3046\u5727\u5012\u7684\u306A\u30B5\u30A4\u30BA\r\n\u3053\u306E\u5973\u795E\u306F\u3001\u53F2\u5B9F\u306E\u500B\u4EBA\u3067\u306F\u306A\u304F\u81EA\u7531\u306E\u64EC\u4EBA\u50CF\u3067\u3042\u308A\u3001\u306E\u3061\u306E\u201C\u30DE\u30EA\u30A2\u30F3\u30CC\u201D\u7684\u306A\u5171\u548C\u56FD\u306E\u30A4\u30E1\u30FC\u30B8\u3068\u7D50\u3073\u3064\u304F\r\n\u795E\u8056\u306A\u7406\u5FF5\u3092\u201C\u793E\u4F1A\u306E\u5E95\u8FBA\u306E\u5973\u6027\u201D\u306B\u898B\u305B\u305F\u7406\u7531\u3068\u3057\u3066\u3001\u30C9\u30E9\u30AF\u30ED\u30EF\u306F\u201C\u795E\u6BBF\u306E\u5973\u795E\u201D\u3068\u3057\u3066\u6E05\u6F54\u306B\u7406\u60F3\u5316\u3059\u308B\u306E\u3067\u306A\u304F\u3001\u8840\u3068\u6CE5\u306E\u73FE\u5834\u306B\u7ACB\u3064\u201C\u8857\u306E\u8EAB\u4F53\u201D\u3068\u3057\u3066\u81EA\u7531\u3092\u63CF\u304D\u3001\u7406\u5FF5\u304C\u7FA4\u8846\u306E\u73FE\u5B9F\u306E\u884C\u52D5\u304B\u3089\u751F\u307E\u308C\u308B\u3068\u601D\u3063\u3066\u3044\u305F"
