  paintingName: "\u30D5\u30EC\u30C7\u30EA\u30C3\u30AF\u30FB\u30B7\u30E7\u30D1\u30F3\u306E\u8096\u50CF"
  artistName: "\u30A6\u30B8\u30A7\u30FC\u30CC\u30FB\u30C9\u30E9\u30AF\u30ED\u30EF"
  infoText: "\u300C\u30D4\u30A2\u30CE\u306E\u8A69\u4EBA\u300D\u30B7\u30E7\u30D1\u30F3\u306E\u3001\u60C5\u71B1\u7684\u3067\u795E\u7D4C\u8CEA\u306A\u5185\u9762\u304C\u898B\u4E8B\u306B\u63CF\u304D\u51FA\u3055\u308C\u305F\u8096\u50CF\u753B\u3002\n\u3057\u304B\u3057\u3053\u306E\u4F5C\u54C1\u306F\u3001\u3082\u3068\u3082\u3068\u5F7C\u306E\u604B\u4EBA\u30B8\u30E7\u30EB\u30B8\u30E5\u30FB\u30B5\u30F3\u30C9\u3068\u5171\u306B\u63CF\u304B\u308C\u305F\u4E8C\u4EBA\u306E\u8096\u50CF\u753B\u306E\u4E00\u90E8\u3067\u3057\u305F\u3002\u4F55\u8005\u304B\u306B\u3088\u3063\u3066\u7121\u6B8B\u306B\u3082\u5F15\u304D\u88C2\u304B\u308C\u305F\u3053\u306E\u7D75\u306F\u3001\u4E8C\u4EBA\u306E\u611B\u306E\u7D50\u672B\u3092\u6697\u793A\u3057\u3066\u3044\u308B\u304B\u306E\u3088\u3046\u3067\u3059\u3002\u5F15\u304D\u88C2\u304B\u308C\u308B\u524D\u306E\u3001\u5143\u306E\u7D75\u306F\u3069\u306E\u3088\u3046\u306A\u69CB\u56F3\u3060\u3063\u305F\u306E\u3067\u3057\u3087\u3046\u3002"
  yearOfProduction: 1838
  endYearOfProduction: 0
  width: 37.5
  height: 45.7
  exhibitionAreaName: E
  additionalInfomation: "\u5143\u3005\u30B8\u30E7\u30EB\u30B8\u30E5\u30FB\u30B5\u30F3\u30C9\u3068\u30B7\u30E7\u30D1\u30F3\u306E\u4E8C\u4EBA\u50CF\u306E\u4E00\u90E8\u3067\u3001\u7D75\u304C\u5F15\u304D\u88C2\u304B\u308C\u3066\u5206\u5272\u3055\u308C\u305F\u3068\u3044\u3046\u6765\u6B74\u304C\u3042\u308B\u3002\u5206\u5272\u306F1863\u301C1874\u5E74\u306E\u9593\u306B\u8D77\u304D\u305F\u3068\u3055\u308C\u3066\u3044\u308B\u3002\r\n\u300C\u5F15\u304D\u88C2\u304B\u308C\u308B\u524D\u306F\u3069\u3093\u306A\u69CB\u56F3\uFF1F\u300D\u306B\u306F\u3001\u30EB\u30FC\u30F4\u30EB\u5074\u3082\u6E96\u5099\u7D20\u63CF\u306E\u5B58\u5728\u3092\u793A\u3057\u3064\u3064\u3001\u6A2A\u9577\u69CB\u56F3\u3092\u793A\u3059\u7D20\u63CF\u3068\u3001\u307B\u307C\u6B63\u65B9\u5F62\u306B\u898B\u3048\u308B\u5225\u8CC7\u6599\u304C\u3042\u308A\u5FA9\u5143\u306F\u4E00\u7FA9\u7684\u3067\u306F\u306A\u3044\r\n\u98FE\u308A\u65B9\u3068\u3057\u3066\u306F\u3001\u4EBA\u7269\u306E\u9854\u306E\u5B58\u5728\u611F\u304C\u5F37\u3044\u306E\u3067\u3001\u6697\u3081\u306E\u58C1\u3084\u9593\u63A5\u7167\u660E\u306E\u3042\u308B\u97F3\u697D\u5BA4\u30FB\u66F8\u658E\u306B\u5408\u3044\u3001\u300C\u30B7\u30E7\u30D1\u30F3\u597D\u304D\u306E\u8D08\u308A\u7269\u300D\u300C\u30D4\u30A2\u30CE\u306E\u6A2A\u306B\u98FE\u308B\u4E00\u679A\u300D\u3068\u3044\u3046\u7528\u9014\u63D0\u6848"
