  m_Name: "4_\u30C7\u30A3\u30A8\u30C3\u30D7\u306E\u9AD8\u53F0\u304B\u3089\u898B\u305F\u6D77"
  m_EditorClassIdentifier: 
  paintingID: 4
  paintingName: "\u30C7\u30A3\u30A8\u30C3\u30D7\u306E\u9AD8\u53F0\u304B\u3089\u898B\u305F\u6D77"
  artistName: "\u30A6\u30B8\u30A7\u30FC\u30CC\u30FB\u30C9\u30E9\u30AF\u30ED\u30EF"
  infoText: "\u8352\u3005\u3057\u3044\u6CE2\u304C\u6253\u3061\u5BC4\u305B\u308B\u30CE\u30EB\u30DE\u30F3\u30C7\u30A3\u30FC\u306E\u6D77\u5CB8\u3002\n\u4E00\u898B\u3059\u308B\u3068\u5358\u306A\u308B\u98A8\u666F\u753B\u3067\u3059\u304C\u3001\u30ED\u30DE\u30F3\u4E3B\u7FA9\u306E\u65D7\u624B\u30C9\u30E9\u30AF\u30ED\u30EF\u306B\u3068\u3063\u3066\u3001\u81EA\u7136\u306F\u81EA\u3089\u306E\u5185\u9762\u3092\u6295\u5F71\u3059\u308B\u93E1\u3067\u3057\u305F\u3002\u5F7C\u304C\u63CF\u304F\u7A7A\u3084\u6D77\u306F\u3001\u5E38\u306B\u3069\u3053\u304B\u5287\u7684\u3067\u611F\u60C5\u7684\u306B\u898B\u3048\u307E\u3059\u3002\n\u3053\u306E\u7A7A\u6A21\u69D8\u3084\u6CE2\u306E\u3046\u306D\u308A\u306B\u3001\u753B\u5BB6\u306F\u3069\u306E\u3088\u3046\u306A\u5FC3\u306E\u72B6\u614B\u3092\u8A17\u3057\u305F\u306E\u3067\u3057\u3087\u3046\u304B\u3002"
  yearOfProduction: 1852
  endYearOfProduction: 0
  width: 51
  height: 35
  exhibitionAreaName: G
  additionalInfomation: "\u5236\u4F5C\u5E74\u306F\u3057\u3070\u3057\u30701852\u5E74\u3068\u3055\u308C\u3001\u30E1\u30C8\u30ED\u30DD\u30EA\u30BF\u30F3\u7F8E\u8853\u9928\u306E\u4F5C\u54C1\u60C5\u5831\u3067\u30821852\u5E74\u4F5C\u3068\u3057\u3066\u7D39\u4ECB\u3055\u308C\u3066\u3044\u308B\u4E00\u65B9\u3067\u3001\u30EB\u30FC\u30F4\u30EB\u5074\u306E\u30C7\u30FC\u30BF\u30D9\u30FC\u30B9\u3067\u306F\u5E74\u4EE3\u5E45\u3092\u6301\u305F\u305B\u3066\u767B\u9332\u3057\u3066\u304A\u308A\u3001\u300C\u5E74\u4EE3\u3082\u542B\u3081\u3066\u7814\u7A76\u304C\u7D9A\u304F\u4F5C\u54C1\u300D\u3068\u3044\u3046\u201C\u901A\u3063\u307D\u3044\u9762\u767D\u3055\u201D\u304C\u8A9E\u308C\u307E\u3059\u3002\r\n\u30E1\u30C8\u306E\u60C5\u5831\u3067\u306F\u6765\u6B74\u3068\u3057\u30661979\u5E74\u306B\u30EB\u30FC\u30F4\u30EB\u3078\u907A\u8D08\u3055\u308C\u305F\u3053\u3068\u3082\u793A\u3055\u308C\u3066\u3044\u3066\u3001\u8FD1\u4EE3\u306B\u306A\u3063\u3066\u8A55\u4FA1\u304C\u7A4D\u307F\u4E0A\u304C\u3063\u305F\u30BF\u30A4\u30D7\u306E\u4F5C\u54C1\u3060\u3068\u4F1D\u3048\u3089\u308C\u307E\u3059\u3002\r\n\u307E\u305F\u30EB\u30FC\u30F4\u30EB\u306E\u516C\u5F0F\u30B7\u30E7\u30C3\u30D7\u89E3\u8AAC\u306B\u306F\u3001\u30C9\u30E9\u30AF\u30ED\u30EF\u306E\u65E5\u8A18\uFF081852\u5E749\u670814\u65E5\u4ED8\uFF09\u3068\u3057\u3066\u300C\u6D77\u3092\u96E2\u308C\u308B\u306E\u306F\u9577\u304F\u611B\u3057\u305F\u4EBA\u3092\u7F6E\u3044\u3066\u3044\u304F\u3088\u3046\u3060\u300D\u3068\u3044\u3063\u305F\u8DA3\u65E8\u306E\u8A00\u8449\u304C\u5F15\u304B\u308C\u3066\u304A\u308A\u3001\u98A8\u666F\u304C\u201C\u89B3\u5149\u306E\u666F\u8272\u201D\u3067\u306F\u306A\u304F\u201C\u500B\u4EBA\u7684\u306A\u5225\u308C\u201D\u3068\u3057\u3066\u63CF\u304B\u308C\u305F\u3001\u3068\u58F2\u308A\u5834\u3067\u8A9E\u308B\u3068\u4E00\u6C17\u306B\u30ED\u30DE\u30F3\u304C\u7ACB\u3061\u307E\u3059\u3002\r\n\u8CFC\u5165\u63D0\u6848\u3068\u3057\u3066\u306F\u3001\u6A2A\u9577\u3067\u6CE2\u3068\u7A7A\u304C\u4E3B\u5F79\u306A\u306E\u3067\u3001\u5ECA\u4E0B\u3084\u30BD\u30D5\u30A1\u80CC\u9762\u306B\u5408\u308F\u305B\u3084\u3059\u304F\u3001\u767D\u3044\u30DE\u30C3\u30C8\u3068\u7D30\u3081\u306E\u984D\u3067\u4F59\u767D\u3092\u4F5C\u308B\u3068\u300C\u5C0F\u54C1\u306A\u306E\u306B\u30C9\u30E9\u30DE\u304C\u3042\u308B\u300D\u611F\u3058\u304C\u51FA\u3066\u6E80\u8DB3\u5EA6\u304C\u9AD8\u3044\u3002"
