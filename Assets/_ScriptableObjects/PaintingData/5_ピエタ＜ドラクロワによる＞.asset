  paintingName: "\u30D4\u30A8\u30BF\uFF1C\u30C9\u30E9\u30AF\u30ED\u30EF\u306B\u3088\u308B\uFF1E"
  artistName: "\u30D5\u30A3\u30F3\u30BB\u30F3\u30C8\u30FB\u30D5\u30A1\u30F3\u30FB\u30B4\u30C3\u30DB"
  infoText: "\u656C\u611B\u3059\u308B\u30C9\u30E9\u30AF\u30ED\u30EF\u306E\u300C\u30D4\u30A8\u30BF\u300D\u3092\u3001\u30B4\u30C3\u30DB\u304C\u72EC\u81EA\u306E\u8272\u4F7F\u3044\u3067\u6A21\u5199\u3057\u305F\u4F5C\u54C1\u3067\u3059\u3002\u3057\u304B\u3057\u3001\u3088\u304F\u898B\u308B\u3068\u3001\u5341\u5B57\u67B6\u304B\u3089\u964D\u308D\u3055\u308C\u305F\u30AD\u30EA\u30B9\u30C8\u306E\u9854\u306F\u3001\u30B4\u30C3\u30DB\u81EA\u8EAB\u306E\u9854\u306B\u3069\u3053\u304B\u4F3C\u3066\u3044\u308B\u3068\u8A00\u308F\u308C\u3066\u3044\u307E\u3059\u3002\n\u7642\u990A\u9662\u3067\u63CF\u304B\u308C\u305F\u3053\u306E\u7D75\u3067\u3001\u5F7C\u306F\u30AD\u30EA\u30B9\u30C8\u306E\u82E6\u96E3\u306B\u81EA\u3089\u306E\u59FF\u3092\u91CD\u306D\u5408\u308F\u305B\u305F\u306E\u3067\u3057\u3087\u3046\u304B\u3002\u8056\u6BCD\u30DE\u30EA\u30A2\u306E\u60B2\u3057\u307F\u304C\u3001\u9BAE\u3084\u304B\u306A\u9752\u8272\u3067\u3088\u308A\u4E00\u5C64\u969B\u7ACB\u3061\u307E\u3059\u3002"
  yearOfProduction: 1889
  endYearOfProduction: 0
  width: 60.5
  height: 54.2
  exhibitionAreaName: B
  additionalInfomation: "\u30A2\u30E0\u30B9\u30C6\u30EB\u30C0\u30E0\u306E\u30D5\u30A1\u30F3\u30FB\u30B4\u30C3\u30DB\u7F8E\u8853\u9928\u6240\u8535\u3002\u30C9\u30E9\u30AF\u30ED\u30EF\u306E\u30EA\u30C8\u30B0\u30E9\u30D5\u3092\u3082\u3068\u306B\u3001\u30B4\u30C3\u30DB\u304C\u72EC\u81EA\u306E\u8272\u5F69\u3067\u518D\u69CB\u7BC9\u3057\u305F\u300C\u540D\u753B\u306E\u4E8C\u91CD\u30AA\u30DE\u30FC\u30B8\u30E5\u300D\u3068\u3082\u547C\u3079\u308B\u4F5C\u54C1\u3067\u3059\u3002\n\n\u7CBE\u795E\u7684\u306A\u82E6\u60A9\u306E\u4E2D\u306B\u3042\u3063\u305F\u30B4\u30C3\u30DB\u304C\u3001\u904E\u53BB\u306E\u5DE8\u5320\u3092\u6A21\u5199\u3059\u308B\u3053\u3068\u3067\u81EA\u5DF1\u3092\u7ACB\u3066\u76F4\u305D\u3046\u3068\u3057\u305F\u6642\u671F\u306E\u3082\u306E\u3067\u3001\u300C\u82E6\u3057\u307F\u3092\u501F\u308A\u3066\u81EA\u5206\u306E\u8272\u3067\u4E57\u308A\u8D8A\u3048\u308B\u300D\u3068\u3044\u3046\u5F37\u3044\u610F\u5FD7\u304C\u8FBC\u3081\u3089\u308C\u3066\u3044\u307E\u3059\u3002\n\n\u9752\u3092\u57FA\u8ABF\u3068\u3057\u305F\u30E2\u30C0\u30F3\u306A\u8272\u9762\u69CB\u6210\u306F\u3001\u5B97\u6559\u753B\u3067\u3042\u308A\u306A\u304C\u3089\u73FE\u4EE3\u7684\u306A\u30A4\u30F3\u30C6\u30EA\u30A2\u306B\u3082\u99B4\u67D3\u307F\u3001\u548C\u5BA4\u306E\u5E8A\u306E\u9593\u3084\u5BDD\u5BA4\u306A\u3069\u3001\u9759\u304B\u306A\u201C\u7948\u308A\u306E\u7A7A\u9593\u201D\u306B\u6700\u9069"
