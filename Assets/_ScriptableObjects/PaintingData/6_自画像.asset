  paintingID: 6
  paintingName: "\u81EA\u753B\u50CF"
  artistName: "\u30D5\u30A3\u30F3\u30BB\u30F3\u30C8\u30FB\u30D5\u30A1\u30F3\u30FB\u30B4\u30C3\u30DB"
  infoText: "\u30B5\u30F3\uFF1D\u30EC\u30DF\u306E\u7642\u990A\u9662\u3067\u63CF\u304B\u308C\u305F\u3001\u30B4\u30C3\u30DB\u306E\u6700\u3082\u6709\u540D\u306A\u81EA\u753B\u50CF\u306E\u4E00\u3064\u3067\u3059\u3002\n\u843D\u3061\u7740\u3044\u305F\u4E0A\u7740\u306E\u8272\u3068\u306F\u5BFE\u7167\u7684\u306B\u3001\u80CC\u666F\u306F\u300A\u661F\u6708\u591C\u300B\u3092\u601D\u308F\u305B\u308B\u9752\u3044\u6E26\u306B\u652F\u914D\u3055\u308C\u3066\u3044\u307E\u3059\u3002\n\u5F7C\u306E\u4E0D\u52D5\u306E\u8996\u7DDA\u3068\u786C\u304F\u7D50\u3070\u308C\u305F\u53E3\u5143\u306F\u3001\u5185\u306A\u308B\u5D50\u3092\u61F8\u547D\u306B\u5236\u5FA1\u3057\u3088\u3046\u3068\u3059\u308B\u753B\u5BB6\u306E\u5F37\u3044\u610F\u5FD7\u306E\u8868\u308C\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3002\u3053\u306E\u77B3\u306F\u3001\u79C1\u305F\u3061\u306B\u4F55\u3092\u8A34\u3048\u304B\u3051\u3066\u3044\u308B\u306E\u3067\u3057\u3087\u3046\u304B\u3002"
  yearOfProduction: 1889
  endYearOfProduction: 0
  width: 54.2
  height: 65
  exhibitionAreaName: F
  additionalInfomation: "\u30D1\u30EA\u306E\u30AA\u30EB\u30BB\u30FC\u7F8E\u8853\u9928\u304C\u6240\u8535\u3059\u308B1889\u5E749\u6708\u306E\u4F5C\u54C1\u3067\u3001\u7E2665cm\xD7\u6A2A54cm\u3068\u3044\u3046\u30B5\u30A4\u30BA\u4EE5\u4E0A\u306B\u300C\u9854\u304C\u90E8\u5C4B\u3092\u652F\u914D\u3059\u308B\u300D\u3088\u3046\u306A\u5F37\u3044\u5B58\u5728\u611F\u3092\u6301\u3064\n\n\u5358\u306A\u308B\u611F\u60C5\u306E\u8868\u51FA\u306B\u3068\u3069\u307E\u3089\u305A\u3001\u30B4\u30C3\u30DB\u304C\u81EA\u8EAB\u3092\u30E2\u30C7\u30EB\u306B\u7B46\u89E6\u3084\u8272\u5F69\u306E\u52B9\u679C\u3092\u8A66\u3057\u305F\u300C\u5B9F\u9A13\u306E\u5834\u300D\u3067\u3082\u3042\u308A\u3001\u80CC\u666F\u306E\u6E26\u306F\u7D75\u5177\u306E\u7814\u7A76\u6210\u679C\u3068\u3057\u3066\u3082\u8A9E\u308B\u3053\u3068\u304C\u3067\u304D\u308B\n\n\u9752\u306E\u8272\u8ABF\u304C\u5F37\u3044\u305F\u3081\u3001\u771F\u3063\u767D\u306A\u58C1\u3088\u308A\u3082\u6696\u8272\u306E\u7167\u660E\u3084\u6728\u306E\u5BB6\u5177\u304C\u3042\u308B\u7A7A\u9593\u306B\u98FE\u308B\u307B\u3046\u304C\u9854\u8272\u304C\u6620\u3048\u3084\u3059\u304F\u3001\u6240\u8535\u9928\u304C\u660E\u78BA\u306A\u300C\u30AA\u30EB\u30BB\u30FC\u7248\u300D\u3068\u3057\u3066\u6307\u540D\u8CB7\u3044\u3055\u308C\u3084\u3059\u3044\u540D\u753B\u3067\u3042\u308B"
