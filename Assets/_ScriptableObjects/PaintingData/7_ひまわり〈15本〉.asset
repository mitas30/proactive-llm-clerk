  m_Name: "7_\u3072\u307E\u308F\u308A\u300815\u672C\u3009"
  m_EditorClassIdentifier: 
  paintingID: 7
  paintingName: "\u3072\u307E\u308F\u308A\u300815\u672C\u3009"
  artistName: "\u30D5\u30A3\u30F3\u30BB\u30F3\u30C8\u30FB\u30D5\u30A1\u30F3\u30FB\u30B4\u30C3\u30DB"
  infoText: "\u5357\u4ECF\u30A2\u30EB\u30EB\u306E\u5F37\u3044\u65E5\u5DEE\u3057\u3092\u6D74\u3073\u305F\u3072\u307E\u308F\u308A\u3002\n\u53CB\u4EBA\u30B4\u30FC\u30AE\u30E3\u30F3\u3092\u8FCE\u3048\u308B\u305F\u3081\u306B\u63CF\u304B\u308C\u305F\u3053\u306E\u7D75\u306F\u3001\u30B4\u30C3\u30DB\u306E\u5E0C\u671B\u3068\u60C5\u71B1\u306B\u6E80\u3061\u3066\u3044\u307E\u3059\u3002\u3057\u304B\u3057\u3001\u4E8C\u4EBA\u306E\u5171\u540C\u751F\u6D3B\u306F\u308F\u305A\u304B2\u30F6\u6708\u3067\u7834\u7DBB\u3057\u307E\u3057\u305F\u3002\n\u8F1D\u304B\u3057\u3044\u751F\u547D\u529B\u306E\u8C61\u5FB4\u3067\u3042\u308B\u3072\u307E\u308F\u308A\u306F\u3001\u305D\u306E\u5F8C\u306E\u30B4\u30C3\u30DB\u306E\u76EE\u306B\u306F\u3069\u306E\u3088\u3046\u306B\u6620\u3063\u3066\u3044\u305F\u306E\u3067\u3057\u3087\u3046\u304B\u3002\u540C\u3058\u30E2\u30C1\u30FC\u30D5\u304C\u753B\u5BB6\u306E\u5FC3\u5883\u3067\u610F\u5473\u3092\u5909\u3048\u308B\u306E\u3067\u3059\u3002"
  yearOfProduction: 1888
  endYearOfProduction: 0
  width: 73
  height: 92
  exhibitionAreaName: C
  additionalInfomation: "\u30ED\u30F3\u30C9\u30F3\u30FB\u30CA\u30B7\u30E7\u30CA\u30EB\u30FB\u30AE\u30E3\u30E9\u30EA\u30FC\u6240\u8535\u306E\u300C15\u672C\u300D\u30D0\u30FC\u30B8\u30E7\u30F3\u3067\u3001\u82B1\u74F6\u3084\u82B1\u5F01\u306E\u8F2A\u90ED\u7DDA\u304C\u529B\u5F37\u304F\u63CF\u304B\u308C\u3066\u3044\u308B\u305F\u3081\u3001\u9060\u76EE\u3067\u3082\u7D75\u304C\u6210\u7ACB\u3057\u3001\u4EBA\u306E\u52D5\u304D\u304C\u3042\u308B\u5834\u6240\u3067\u3082\u5B58\u5728\u611F\u3092\u5931\u308F\u306A\u3044\n\n\u30B4\u30C3\u30DB\u304C\u300C\u8AB0\u304B\u3092\u8FCE\u3048\u308B\u305F\u3081\u306B\u63CF\u3044\u305F\u300D\u3068\u3044\u3046\u5236\u4F5C\u80CC\u666F\u304C\u3042\u308B\u305F\u3081\u3001\u5358\u306A\u308B\u9759\u7269\u753B\u3068\u3057\u3066\u3060\u3051\u3067\u306A\u304F\u3001\u6765\u5BA2\u3078\u306E\u6B53\u8FCE\u3084\u8D08\u308A\u7269\u3068\u3057\u3066\u306E\u610F\u5473\u3092\u6301\u305F\u305B\u3066\u63D0\u6848\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u308B\n\n\u80CC\u666F\u306E\u9EC4\u8272\u304C\u7279\u5FB4\u7684\u3067\u3042\u308B\u305F\u3081\u3001\u30DE\u30C3\u30C8\u7D19\u3067\u843D\u3061\u7740\u304B\u305B\u308B\u304B\u3001\u30AD\u30E3\u30F3\u30D0\u30B9\u5730\u3067\u7D75\u5177\u306E\u8CEA\u611F\u3092\u51FA\u3059\u304B\u306B\u3088\u3063\u3066\u5370\u8C61\u304C\u5909\u308F\u308A\u3001\u7248\u9055\u3044\u306E\u30B3\u30EC\u30AF\u30B7\u30E7\u30F3\u3068\u3057\u3066\u3082\u697D\u3057\u3081\u308B\u4F5C\u54C1\u3067\u3042\u308B"
