  paintingID: 8
  paintingName: "\u661F\u6708\u591C"
  artistName: "\u30D5\u30A3\u30F3\u30BB\u30F3\u30C8\u30FB\u30D5\u30A1\u30F3\u30FB\u30B4\u30C3\u30DB"
  infoText: "\u7642\u990A\u6240\u306E\u7A93\u304B\u3089\u898B\u305F\u591C\u660E\u3051\u524D\u306E\u98A8\u666F\u3067\u3059\u304C\u3001\u4E2D\u592E\u306E\u6559\u4F1A\u306F\u30B4\u30C3\u30DB\u306E\u6545\u90F7\u30AA\u30E9\u30F3\u30C0\u306E\u8A18\u61B6\u306B\u57FA\u3065\u3044\u3066\u3044\u307E\u3059\u3002\n\u5929\u6587\u5B66\u8005\u304C\u8A08\u7B97\u3057\u305F\u661F\u306E\u914D\u7F6E\u306F\u9A5A\u304F\u307B\u3069\u6B63\u78BA\u3067\u3001\u3072\u3068\u304D\u308F\u660E\u308B\u3044\u661F\u306F\u91D1\u661F\u3060\u305D\u3046\u3067\u3059\u3002\u79D1\u5B66\u7684\u306A\u6B63\u78BA\u3055\u306E\u4E2D\u306B\u6E26\u5DFB\u304F\u3053\u306E\u6FC0\u3057\u3044\u611F\u60C5\u306F\u3001\u3069\u3053\u304B\u3089\u6765\u305F\u306E\u3067\u3057\u3087\u3046\u304B\u3002\n\u73FE\u5B9F\u3068\u8A18\u61B6\u3001\u305D\u3057\u3066\u5E7B\u8996\u304C\u878D\u5408\u3057\u305F\u30B4\u30C3\u30DB\u306E\u5FC3\u8C61\u98A8\u666F\u3067\u3059\u3002"
  yearOfProduction: 1889
  endYearOfProduction: 0
  width: 60.5
  height: 73
  exhibitionAreaName: G
  additionalInfomation: "\u30CB\u30E5\u30FC\u30E8\u30FC\u30AF\u8FD1\u4EE3\u7F8E\u8853\u9928\uFF08MoMA\uFF09\u3092\u4EE3\u8868\u3059\u308B\u540D\u4F5C\u3067\u3001\u5B9F\u666F\u306E\u5199\u751F\u3067\u306F\u306A\u304F\u3001\u8A18\u61B6\u3068\u69CB\u6210\u304C\u6DF7\u3056\u308A\u5408\u3063\u305F\u300C\u5FC3\u8C61\u98A8\u666F\u300D\u3068\u3057\u3066\u63CF\u304B\u308C\u305F\u3001\u8AB0\u306E\u5FC3\u306B\u3082\u5165\u308A\u8FBC\u3080\u666E\u904D\u7684\u306A\u591C\u306E\u7D75\n\n\u5B9F\u7269\u306F\u6A2A\u9577\u306E\u6BD4\u7387\u3067\u3042\u308B\u305F\u3081\u3001\u5BDD\u5BA4\u306E\u30D9\u30C3\u30C9\u3084\u30BD\u30D5\u30A1\u306E\u80CC\u9762\u306B\u5408\u308F\u305B\u308B\u3068\u300C\u6A2A\u9577\u306E\u7A93\u300D\u306E\u3088\u3046\u306B\u7A7A\u9593\u306B\u99B4\u67D3\u307F\u3084\u3059\u304F\u3001\u9752\u3068\u9EC4\u306E\u5BFE\u6BD4\u304C\u6697\u3044\u7167\u660E\u306E\u4E0B\u3067\u3082\u6C88\u307E\u305A\u306B\u7F8E\u3057\u304F\u6620\u3048\u308B\n\nMoMA\u3068\u3044\u3046\u73FE\u4EE3\u7F8E\u8853\u306E\u6BBF\u5802\u304C\u30B3\u30EC\u30AF\u30B7\u30E7\u30F3\u306E\u6838\u3068\u3059\u308B\u4F5C\u54C1\u3067\u3042\u308A\u3001\u30DD\u30B9\u30BF\u30FC\u7684\u306B\u6D88\u8CBB\u3055\u308C\u304C\u3061\u3060\u304C\u3001\u5B9F\u5BF8\u5927\u3067\u98FE\u308B\u3053\u3068\u3067\u300C\u500B\u4EBA\u306E\u591C\u300D\u3092\u8C4A\u304B\u306B\u3059\u308B\u30A4\u30F3\u30C6\u30EA\u30A2\u3068\u3057\u3066\u6A5F\u80FD\u3059\u308B"
