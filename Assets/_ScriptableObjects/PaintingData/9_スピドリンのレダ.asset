  m_Name: "9_\u30B9\u30D4\u30C9\u30EA\u30F3\u306E\u30EC\u30C0"
  m_EditorClassIdentifier: 
  paintingID: 9
  paintingName: "\u30B9\u30D4\u30C9\u30EA\u30F3\u306E\u30EC\u30C0"
  artistName: "\u30EC\u30AA\u30CA\u30EB\u30C9\u30FB\u30C0\u30FB\u30F4\u30A3\u30F3\u30C1"
  infoText: "\u767D\u9CE5\u306B\u59FF\u3092\u5909\u3048\u305F\u795E\u30BC\u30A6\u30B9\u3068\u3001\u30B9\u30D1\u30EB\u30BF\u306E\u738B\u5983\u30EC\u30C0\u3092\u63CF\u3044\u305F\u795E\u8A71\u306E\u4E00\u5834\u9762\u3002\u5B9F\u306F\u3053\u306E\u4F5C\u54C1\u306F\u3001\u30EC\u30AA\u30CA\u30EB\u30C9\u30FB\u30C0\u30FB\u30F4\u30A3\u30F3\u30C1\u306E\u5931\u308F\u308C\u305F\u5091\u4F5C\u306E\u5FE0\u5B9F\u306A\u6A21\u5199\u3068\u8003\u3048\u3089\u308C\u3066\u3044\u307E\u3059\u3002\n\u306A\u305C\u30AA\u30EA\u30B8\u30CA\u30EB\u306E\u7D75\u306F\u6B74\u53F2\u304B\u3089\u59FF\u3092\u6D88\u3057\u3066\u3057\u307E\u3063\u305F\u306E\u3067\u3057\u3087\u3046\u304B\u3002\n\u6B8B\u3055\u308C\u305F\u6570\u679A\u306E\u6A21\u5199\u3060\u3051\u304C\u3001\u5929\u624D\u304C\u63CF\u3044\u305F\u6700\u3082\u5B98\u80FD\u7684\u306A\u4F5C\u54C1\u306E\u9762\u5F71\u3092\u4ECA\u306B\u4F1D\u3048\u3066\u3044\u307E\u3059\u3002"
  yearOfProduction: 1505
  endYearOfProduction: 1515
  width: 77.5
  height: 130
  exhibitionAreaName: A
  additionalInfomation: "\u73FE\u5728\u306F\u30A6\u30D5\u30A3\u30C4\u30A3\u7F8E\u8853\u9928\u306B\u6240\u8535\u3055\u308C\u3001\u5931\u308F\u308C\u305F\u30EC\u30AA\u30CA\u30EB\u30C9\u306E\u771F\u7B46\u300A\u30EC\u30C0\u3068\u767D\u9CE5\u300B\u306E\u69CB\u56F3\u3092\u4F1D\u3048\u308B\u3001\u30B9\u30D4\u30EA\u30C9\u30F3\u30FB\u30B3\u30EC\u30AF\u30B7\u30E7\u30F3\u7531\u6765\u306E\u6700\u3082\u91CD\u8981\u306A\u6A21\u5199\u306E\u4E00\u3064\u3067\u3042\u308B\n\n\u4F5C\u8005\u306B\u3064\u3044\u3066\u306F\u30EC\u30AA\u30CA\u30EB\u30C9\u672C\u4EBA\u8AAC\u304B\u3089\u5F1F\u5B50\uFF08\u30E1\u30EB\u30C4\u30A3\u7B49\uFF09\u8AAC\u307E\u3067\u63FA\u308C\u52D5\u304F\u304C\u3001\u305D\u306E\u300C\u63FA\u3089\u304E\u300D\u81EA\u4F53\u304C\u30B3\u30EC\u30AF\u30B7\u30E7\u30F3\u53F2\u4E0A\u306E\u8A55\u4FA1\u3068\u3057\u3066\u8A9E\u3089\u308C\u3001\u77E5\u7684\u597D\u5947\u5FC3\u3092\u523A\u6FC0\u3059\u308B\u8981\u7D20\u3068\u306A\u308B\n\n\u300A\u30E2\u30CA\u30FB\u30EA\u30B6\u300B\u306E\u9759\u8B10\u306A\u6C88\u9ED9\u3068\u306F\u5BFE\u7167\u7684\u306A\u300C\u5B98\u80FD\u3068\u5909\u8EAB\u306E\u795E\u8A71\u300D\u3092\u63CF\u3044\u3066\u304A\u308A\u3001\u30EC\u30AA\u30CA\u30EB\u30C9\u306E\u3082\u3046\u4E00\u3064\u306E\u9854\u3068\u3057\u3066\u3001\u795E\u8A71\u7684\u306A\u7F8E\u3092\u6C42\u3081\u308B\u7A7A\u9593\u306B\u76F8\u5FDC\u3057\u3044\u4F5C\u54C1\u3067\u3042\u308B"
