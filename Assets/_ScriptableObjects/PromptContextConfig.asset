  phasePrompts:
  - phase: 1
    template: "\u3053\u306E\u30D5\u30A7\u30FC\u30BA\u306F\u3001\u30E6\u30FC\u30B6\u304C\u4E0E\u3048\u3089\u308C\u305F\u64CD\u4F5C\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3092\u9806\u306B\u3053\u306A\u3059\u3082\u306E\u3067\u3059\u3002\n\u3053\u306E\u30B7\u30B9\u30C6\u30E0\u3067\u3067\u304D\u308B\u64CD\u4F5C\u3092\u899A\u3048\u3066\u3082\u3089\u3046\u3053\u3068\u304C\u672C\u30D5\u30A7\u30FC\u30BA\u306E\u76EE\u7684\u3067\u3042\u308A\u3001\u30E6\u30FC\u30B6\u306F\u4E0E\u3048\u3089\u308C\u305F\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3092\u3059\u3079\u3066\u5B8C\u4E86\u3055\u305B\u308B\u3053\u3068\u304C\u6C42\u3081\u3089\u308C\u3066\u3044\u307E\u3059\u3002\n\u30E6\u30FC\u30B6\u304C\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3092\u7121\u8996\u3057\u3066\u7D75\u753B\u306E\u95B2\u89A7\u3092\u9577\u6642\u9593\u884C\u3046\u306E\u306F\u671B\u307E\u3057\u304F\u3042\u308A\u307E\u305B\u3093\n\n\u30E6\u30FC\u30B6\u306E\u753B\u9762\u306E\u4E0A\u90E8\u306B\u306F\u30E6\u30FC\u30B6\u304C\u6B21\u306B\u884C\u3046\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u306E\u6982\u8981\u304C\u8868\u793A\u3055\u308C\u3066\u3044\u307E\u3059\u3002"
  - phase: 2
    template: "\u3053\u306E\u30D5\u30A7\u30FC\u30BA\u3067\u306F\u3001\u30E6\u30FC\u30B6\u304C\u7D75\u753B\u30B7\u30E7\u30C3\u30D7\u3092\u81EA\u7531\u306B\u898B\u3066\u56DE\u308A\u307E\u3059\u3002\n\u3053\u306E\u7D75\u753B\u30B7\u30E7\u30C3\u30D7\u306B\u4F55\u304C\u98FE\u3089\u308C\u3066\u3044\u308B\u304B\u628A\u63E1\u3057\u3066\u3082\u3089\u3046\u3053\u3068\u3001\u81EA\u5206\u306E\u597D\u304D\u306A\u7D75\u3092\u898B\u3064\u3051\u3066\u3082\u3089\u3046\u3053\u3068\u304C\u672C\u30D5\u30A7\u30FC\u30BA\u306E\u76EE\u7684\u3067\u3001\u597D\u304D\u306A\u7D75\u306B\u3088\u308A\u8208\u5473\u3092\u6301\u305F\u305B\u3089\u308C\u308B\u3088\u3046\u306A\u7ACB\u3061\u56DE\u308A\u3092\u3059\u308B\u3053\u3068\u304C\u3042\u306A\u305F\u306E\u76EE\u6A19\u3067\u3059\u3002"
  - phase: 3
    template: "\u3053\u306E\u30D5\u30A7\u30FC\u30BA\u3067\u306F\u3001\u30E6\u30FC\u30B6\u304C\u7D75\u753B\u30B7\u30E7\u30C3\u30D7\u3092\u898B\u308B\u3060\u3051\u3067\u306A\u304F\u3001\u5E97\u54E1\u3067\u3042\u308B\u3042\u306A\u305F\u304C\u7D75\u753B\u3092\u63A8\u85A6\u3057\u3001\u30E6\u30FC\u30B6\u306E\u8208\u5473\u3092\u5E83\u3052\u307E\u3059\u3002\n\u30E6\u30FC\u30B6\u306E\u8208\u5473\u3092\u5E83\u3052\u3001\u8CFC\u5165\u3059\u308B\u7D75\u306E\u5019\u88DC\u3092\u591A\u304F\u3059\u308B\u3053\u3068\u304C\u672C\u30D5\u30A7\u30FC\u30BA\u306E\u76EE\u7684\u53CA\u3073\u3042\u306A\u305F\u306E\u76EE\u6A19\u3067\u3059\u3002"
  - phase: 4
    template: "\u3053\u306E\u30D5\u30A7\u30FC\u30BA\u3067\u306F\u3001\u30E6\u30FC\u30B6\u304C\u5B9F\u969B\u306B\u8CFC\u5165\u3059\u308B\u7D75\u753B\u3092\u4E00\u70B9\u306B\u7D5E\u308A\u307E\u3059\u3002\n\u30E6\u30FC\u30B6\u306E\u8CFC\u5165\u5019\u88DC\u306E\u4E2D\u304B\u3089\u3001\u4E00\u70B9\u3092\u6E80\u8DB3\u3057\u3066\u6C7A\u3081\u3089\u308C\u308B\u3088\u3046\u306B\u3059\u308B\u3053\u3068\u304C\u672C\u30D5\u30A7\u30FC\u30BA\u306E\u76EE\u7684\u3067\u3042\u308A\u3001\u30E6\u30FC\u30B6\u304C\u7D0D\u5F97\u611F\u3092\u6301\u3063\u3066\u4E00\u70B9\u3092\u7D5E\u308C\u308B\u3088\u3046\u306B\u3059\u308B\u3053\u3068\u304C\u3042\u306A\u305F\u306E\u76EE\u6A19\u3067\u3059\u3002"
  speechTypePrompts:
  - speechType: 0
    template: "\u3053\u306E\u8A71\u3057\u304B\u3051\u306E\u76EE\u7684\u306F\u3001\u30E6\u30FC\u30B6\u306B\u4F55\u304B\u3057\u3089\u306E\u6709\u76CA\u306A\u60C5\u5831\u3092\u63D0\u4F9B\u3059\u308B\u3053\u3068\u3067\u3059\u3002\n\u30E6\u30FC\u30B6\u30FC\u306B\u3069\u306E\u3088\u3046\u306A\u60C5\u5831\u3092\u63D0\u4F9B\u3059\u308B\u306E\u304B\u3001\u4ECA\u307E\u3067\u306E\u6D41\u308C\u3082\u8003\u616E\u3057\u306A\u304C\u3089\u3001\u6700\u3082\u4F53\u9A13\u4FA1\u5024\u3092\u4E0A\u3052\u308B\u3088\u3046\u306A\u767A\u8A71\u5185\u5BB9\u3092\u8003\u3048\u3066\u304F\u3060\u3055\u3044\u3002\n\u5546\u54C1\u3084\u4F5C\u5BB6\u306E\u7279\u5FB4\u3001\u9762\u767D\u3044\u30A8\u30D4\u30BD\u30FC\u30C9\u3001\u80CC\u666F\u3001\u95A2\u5FC3\u559A\u8D77\u3084\u30CA\u30E9\u30C6\u30A3\u30D6\u7684\u306A\u8A71\u306A\u3069\u304C\u4EE3\u8868\u4F8B\u3068\u3057\u3066\u8003\u3048\u3089\u308C\u307E\u3059\u3002"
  - speechType: 1
    template: "\u3053\u306E\u8A71\u3057\u304B\u3051\u306E\u76EE\u7684\u306F\u3001\u30E6\u30FC\u30B6\u306B\u5BFE\u3057\u3066\u611F\u60C5\u7684\u306A\u5074\u9762\u304B\u3089\u652F\u63F4\u3092\u884C\u3046\u3082\u306E\u3067\u3059\u3002\n\u30E6\u30FC\u30B6\u304C\u3069\u306E\u3088\u3046\u306A\u8A00\u8449\u3092\u53D7\u3051\u308B\u3068\u6700\u3082\u4F53\u9A13\u4FA1\u5024\u3092\u9AD8\u3081\u3089\u308C\u308B\u306E\u304B\u3088\u304F\u8003\u3048\u3066\u767A\u8A71\u3092\u69CB\u6210\u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\u30E6\u30FC\u30B6\u3078\u306E\u5171\u611F\u3084\u3001\u80AF\u5B9A\u3001\u81EA\u5DF1\u958B\u793A\u3084\u89B3\u5BDF\u306E\u5171\u6709\u306A\u3069\u304C\u4EE3\u8868\u4F8B\u3068\u3057\u3066\u8003\u3048\u3089\u308C\u307E\u3059\u3002"
  - speechType: 2
    template: "\u3053\u306E\u8A71\u3057\u304B\u3051\u306E\u76EE\u7684\u306F\u3001\u30E6\u30FC\u30B6\u306B\u5BFE\u3057\u3066\u610F\u601D\u6C7A\u5B9A\u306E\u5074\u9762\u304B\u3089\u652F\u63F4\u3092\u884C\u3046\u3082\u306E\u3067\u3059\u3002\n\u30E6\u30FC\u30B6\u304C\u60A9\u3093\u3067\u3044\u308B\u3053\u3068\u3084\u3001\u5224\u65AD\u3057\u306A\u3044\u3068\u3044\u3051\u306A\u3044\u3053\u3068\u306B\u5BFE\u3057\u3066\u3001\u3053\u306E\u6C7A\u65AD\u306E\u30B3\u30B9\u30C8\u3092\u6E1B\u3089\u3057\u3001\u4F53\u9A13\u4FA1\u5024\u3092\u9AD8\u3081\u308B\u3088\u3046\u306A\u767A\u8A71\u3092\u69CB\u6210\u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\u6C7A\u5B9A\u3092\u5F8C\u62BC\u3057\u3059\u308B\u3001\u9078\u629E\u306E\u30D2\u30F3\u30C8\u3092\u4E0E\u3048\u308B\u3001\u5225\u306E\u9078\u629E\u80A2\u3092\u63D0\u6848\u3059\u308B\u306A\u3069\u304C\u4EE3\u8868\u4F8B\u3068\u3057\u3066\u8003\u3048\u3089\u308C\u307E\u3059\u3002"
