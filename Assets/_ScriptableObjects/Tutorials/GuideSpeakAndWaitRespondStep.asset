  m_description: "\u30E6\u30FC\u30B6\u304C\u6C17\u306B\u5165\u3063\u305F\u7D75\u306B\u3064\u3044\u3066\u8CEA\u554F\u3059\u308B\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB"
  m_panelIndex: -1
  m_fadeInDuration: 1.5
  m_fadeOutDuration: 0
  m_promptText: "\u30E6\u30FC\u30B6\u306F\u6C17\u306B\u5165\u3063\u305F\u7D75\u306B\u3064\u3044\u3066\u3001\u30AF\u30EA\u30C3\u30AF\u3057\u305F\u3088\u3046\u3067\u3059\u3002\u6C17\u306B\u5165\u3063\u305F\u7D75\u3092\u307E\u305A\u63A8\u5B9A\u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\u6B21\u306B\u3001\u30AF\u30EA\u30C3\u30AF\u3057\u305F\u7D75\u306B\u5BFE\u3057\u3066\u30E6\u30FC\u30B6\u304C\u805E\u3044\u3066\u304D\u305D\u3046\u306A\u5019\u88DC\u30923\u3064\u4F5C\u6210\u3057\u3066\u304F\u3060\u3055\u3044\u3002\n\u8A71\u3059\u5185\u5BB9\u306F\u3001\u5019\u88DC\u3092\u63D0\u793A\u3057\u305F\u3053\u3068\u3092\u30E6\u30FC\u30B6\u306B\u63D0\u793A\u3059\u308B\u3088\u3046\u306B\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  m_speechText: "\u3053\u3093\u306A\u611F\u3058\u3067\u3001\u7D75\u753B\u3092\u5DE6\u30AF\u30EA\u30C3\u30AF\u3059\u308B\u3068\u3001\u8A73\u7D30\u306A\u60C5\u5831\u304C\u308F\u304B\u308A\u307E\u3059\u3002\n\u3057\u304B\u3057\u3001\u6C17\u306B\u306A\u308B\u3053\u3068\u304C\u3042\u308C\u3070\u3001\u79C1\u306B\u8CEA\u554F\u3057\u3066\u304F\u3060\u3055\u3044\u3001\u7F8E\u8853\u306E\u3053\u3068\u306A\u3089\u4F55\u3067\u3082\u7B54\u3048\u307E\u3059\u3088!\n\u8A66\u3057\u306B\u3001Q\u30DC\u30BF\u30F3\u3092\u62BC\u3057\u3066\u79C1\u306B\u8CEA\u554F\u3057\u3066\u307F\u307E\u3057\u3087\u3046"
  m_middlePanelIndex: 3
