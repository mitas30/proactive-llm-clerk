  m_speechText: "\u3044\u3089\u3063\u3057\u3083\u3044\u307E\u305B!\n\u6C17\u306B\u306A\u308B\u7D75\u753B\u30921\u3064\u898B\u3064\u3051\u3066\u3001\u305D\u306E\u7D75\u753B\u3092\u5DE6\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
